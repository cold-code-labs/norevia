{
 "id": "sim-response-threshold",
 "version": "1.0.0",
 "title": "Response thresholds vs fixed roles vs central dispatcher",
 "seed": 20261107,
 "hypothesis": {
  "statement": "Heterogeneous response thresholds, reading only the local stimulus (backlog), allocate agents adaptively without messages: better latency than fixed roles sized for the mean, fewer active agents than fixed roles sized for the peak, and lower total cost than a central dispatcher when messages have a cost or when the dispatcher's information arrives late.",
  "predictions": [
   {
    "id": "P1",
    "text": "Threshold (theta~U[5,50], n=2, p_quit=0.1) has lower mean latency than fixed-mean (3+3 agents), paired difference with 95% CI excluding 0, using zero messages."
   },
   {
    "id": "P2",
    "text": "Threshold uses fewer active agents on average than fixed-peak (8+8) and has mean latency <= 2x that of fixed-peak."
   },
   {
    "id": "P3",
    "text": "A dispatcher with delay L=0 dominates the threshold rule in (active agents, latency) when messages are free: fewer active agents AND latency <= threshold."
   },
   {
    "id": "P4",
    "text": "Mean latency and peak backlog of the dispatcher grow with the delay L (0<2<5<10); for L>=5 the dispatcher's peak backlog exceeds that of the threshold rule."
   },
   {
    "id": "P5",
    "text": "With a cost of 0.2 per message (relative to 1 agent-step), the total cost per step of the threshold rule is lower than that of any dispatcher (L=0..10)."
   }
  ]
 },
