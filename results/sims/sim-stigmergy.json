{
 "id": "sim-stigmergy",
 "version": "1.0.0",
 "title": "Stigmergy with evaporation vs all-to-all messages vs no coordination",
 "seed": 20261107,
 "hypothesis": {
  "statement": "A shared trail (\"I have already explored here\") reduces duplicated work and time to solution without messages; since agents do not know when an episode ends, old trail becomes noise, and evaporation works as forgetting: there is an optimal intermediate rate, and a trail without evaporation grows without bound.",
  "predictions": [
   {
    "id": "P1",
    "text": "For K=4 and K=16, stigmergy with low evaporation (epsilon=0.01) has lower mean time to solution and lower fraction of duplicated visits than no-coordination (disjoint 95% CIs)."
   },
   {
    "id": "P2",
    "text": "Time to solution is U-shaped in epsilon: there is an intermediate epsilon (0<epsilon<1) with significantly lower time (disjoint 95% CIs) than epsilon=0 and than epsilon=1, for K=4 and K=16."
   },
   {
    "id": "P3",
    "text": "All-to-all messages (perfect information, reset every episode) have the lowest time, at the cost of K(K-1) messages per step; the best stigmergy epsilon is within at most 15% of the time of messages, with zero messages."
   },
   {
    "id": "P4",
    "text": "With epsilon=0, trail mass grows ~linearly with time (unbounded memory) and the 10th episode is slower than the 1st; with the best epsilon the mass stabilises (mass ratio ep.10/ep.5 < 1.2)."
   }
  ]
 },
 "params": {
  "seed": 20261107,
  "grid": 24,
  "neighborhood": 4,
  "Ks": [
   4,
   16
  ],
  "episodes": 10,
  "runs": 500,
  "max_steps_episode": 20000,
  "epsilons": [
   0,
   0.001,
   0.003,
   0.01,
   0.03,
   0.1,
   0.3,
   1
  ],
  "deposit": 1,
  "strategies": {
   "no-coordination": "random walk without immediate return",
   "stigmergy": "moves to the neighbour with the least trail (decayed by (1-epsilon)^dt), ties at random; deposits +1 on arrival; does NOT know when the episode ends",
   "all-to-all-messages": "each agent broadcasts its position to all others every step (K(K-1) msgs/step) + target-found notice (K-1); picks the least-visited neighbour in the current episode"
  },
  "duplicated_work": "fraction of moves that reach a node already visited (by any agent) in the current episode",
  "episode": "target uniform on the grid; the episode ends when an agent steps on the target; a new target appears and agents continue from where they are"
 },
