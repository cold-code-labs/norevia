{
 "id": "sim-clonal",
 "version": "1.0.0",
 "title": "Clonal expansion/contraction vs fixed N",
 "seed": 20261107,
 "hypothesis": {
  "statement": "Scaling multiplicatively while an error signal persists and contracting after resolution gives recovery comparable to a large fixed pool with idle cost close to that of a minimal pool; a persistence filter contains the cost of false alarms, and per-incident-type memory speeds up secondary responses.",
  "predictions": [
   {
    "id": "P1",
    "text": "In the main scenario (false alarm f=0.01), clonal-g2-h1 is not dominated by any fixed N (1,2,4,8,16) in (idle cost, mean recovery time): for each fixed N, clonal is significantly better in at least one of the two metrics."
   },
   {
    "id": "P2",
    "text": "In the main scenario, clonal-g2-h1 has idle cost <= 2x that of fixed-1 and mean recovery time <= that of fixed-4."
   },
   {
    "id": "P3",
    "text": "In the noisy scenario (f=0.05), persistence h=3 reduces idle cost by >= 30% vs h=1, with an increase in recovery time <= 20%."
   },
   {
    "id": "P4",
    "text": "Per-type memory reduces mean recovery time vs no memory (disjoint 95% CIs) with an increase in total cost <= 10%, in the main scenario."
   },
   {
    "id": "P5",
    "text": "Slow contraction (c=0.8) increases idle cost vs c=0.5 without reducing recovery time by more than 5%, in the main scenario."
   }
  ]
 },
